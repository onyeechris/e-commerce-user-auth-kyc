# Copy to .env and fill in. Keep comments on their own line:
# `docker run --env-file` does NOT strip inline "# comments" from values.

SERVICE_NAME=customer-identity-service
# "development" turns on SQL logging
ENVIRONMENT=development
# DEBUG, INFO, WARNING, ERROR. Logs are JSON on stdout (for Promtail/Loki)
LOG_LEVEL=INFO
# True prints OTP codes in the log when mail is not configured (needs ENVIRONMENT=development). Never where logs are shipped
LOG_OTP_CODES=True

# host = the Postgres container name when both run on the same Docker network

# runni it locally
#POSTGRES_DSN=postgresql+asyncpg://app:change-me@localhost:5432/app_db
# runni it on docker
POSTGRES_DSN=postgresql+asyncpg://app:change-me@db:5432/app_db
# True only for managed Postgres that requires SSL (RDS etc.)
DB_REQUIRE_SSL=False

OTP_TTL_MINUTES=10
OTP_ATTEMPT_LIMIT=5
OTP_RESEND_WAIT_SECONDS=60

# comma separated list of frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000
# blank = host-only cookie
SESSION_COOKIE_DOMAIN=
# False on plain http://localhost, True in production (HTTPS)
SESSION_COOKIE_SECURE=False

# long random string: openssl rand -hex 32
TOKEN_SIGNING_KEY=changeme
TOKEN_ALGORITHM=HS256
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7

# OAuth 2.0 Web client ID from Google Cloud Console
GOOGLE_OAUTH_CLIENT_ID=

MAIL_API_KEY=changeme
MAIL_SENDER_EMAIL=noreply@example.com
MAIL_SENDER_NAME=Marketly

RATE_LIMIT_ENABLED=True